{
 "version": 3,
 "tool": "sb",
 "id_flag": "--id",
 "groups": [
  {
   "id": "basic",
   "label": ""
  },
  {
   "id": "client",
   "label": "客户端"
  },
  {
   "id": "proto",
   "label": "协议设置"
  },
  {
   "id": "transport",
   "label": "传输"
  },
  {
   "id": "security",
   "label": "安全"
  },
  {
   "id": "sniffing",
   "label": "嗅探",
   "collapsed": true
  },
  {
   "id": "advanced",
   "label": "高级",
   "collapsed": true
  }
 ],
 "common": [
  "address",
  "__id",
  "remark",
  "region",
  "tags"
 ],
 "fields": {
  "enable": {
   "label": "启用",
   "kind": "switch",
   "group": "basic",
   "top": true,
   "default": true,
   "invert": true,
   "flag": "--disabled",
   "create_only": true
  },
  "name": {
   "label": "备注",
   "kind": "text",
   "group": "basic",
   "top": true,
   "flag": "--name",
   "placeholder": "显示在分享链接里的名称",
   "from": "name"
  },
  "port": {
   "label": "端口",
   "kind": "number",
   "group": "basic",
   "flag": "--port",
   "random": [
    10000,
    60000
   ],
   "required": true,
   "from": "port"
  },
  "total": {
   "label": "总流量",
   "kind": "number",
   "group": "basic",
   "suffix": "GB",
   "placeholder": "0 或留空表示不限",
   "post": {
    "cmd": [
     "traffic",
     "set",
     "{id}"
    ],
    "flag": "--quota",
    "suffix": "G"
   },
   "pattern": "^[1-9]\\d*$",
   "pattern_hint": "填大于 0 的整数，不限制请留空",
   "create_only": true
  },
  "reset_day": {
   "label": "流量重置",
   "kind": "select",
   "group": "basic",
   "empty_label": "不重置",
   "options": [
    {
     "value": "1",
     "label": "每月 1 日"
    },
    {
     "value": "5",
     "label": "每月 5 日"
    },
    {
     "value": "10",
     "label": "每月 10 日"
    },
    {
     "value": "15",
     "label": "每月 15 日"
    },
    {
     "value": "20",
     "label": "每月 20 日"
    },
    {
     "value": "25",
     "label": "每月 25 日"
    },
    {
     "value": "28",
     "label": "每月 28 日"
    }
   ],
   "post": {
    "cmd": [
     "traffic",
     "set",
     "{id}"
    ],
    "flag": "--reset-day"
   },
   "when_filled": "total",
   "create_only": true
  },
  "expiry": {
   "label": "到期时间",
   "kind": "number",
   "group": "basic",
   "suffix": "天后",
   "placeholder": "留空表示永不过期",
   "post": {
    "cmd": [
     "node",
     "expiry",
     "{id}"
    ],
    "flag": "--days"
   },
   "pattern": "^[1-9]\\d*$",
   "pattern_hint": "填大于 0 的天数",
   "create_only": true
  },
  "uuid": {
   "label": "ID",
   "kind": "text",
   "group": "client",
   "flag": "--uuid",
   "generate": "uuid",
   "auto": true,
   "required": true,
   "create_only": true
  },
  "password": {
   "label": "密码",
   "kind": "text",
   "group": "client",
   "flag": "--password",
   "generate": "password:20",
   "auto": true,
   "required": true,
   "create_only": true
  },
  "cred_auto": {
   "label": "凭据",
   "kind": "text",
   "group": "client",
   "value": "创建时自动生成，可在「分享」里查看",
   "readonly": true,
   "create_only": true
  },
  "address": {
   "label": "客户端连接地址",
   "kind": "text",
   "group": "advanced",
   "flag": "--address",
   "placeholder": "留空自动使用域名或本机公网 IP",
   "from": "server_address"
  },
  "__id": {
   "label": "节点 ID",
   "kind": "text",
   "group": "advanced",
   "placeholder": "留空自动生成",
   "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
   "pattern_hint": "小写字母、数字、. _ -",
   "create_only": true
  },
  "remark": {
   "label": "附注",
   "kind": "text",
   "group": "advanced",
   "flag": "--remark",
   "from": "metadata.remark"
  },
  "region": {
   "label": "地区",
   "kind": "text",
   "group": "advanced",
   "flag": "--region",
   "from": "metadata.region"
  },
  "tags": {
   "label": "标签",
   "kind": "text",
   "group": "advanced",
   "flag": "--tags",
   "placeholder": "a,b",
   "from": "metadata.tags"
  },
  "sni": {
   "label": "SNI",
   "kind": "text",
   "group": "security",
   "flag": "--domain",
   "placeholder": "留空使用推荐站点",
   "note": "伪装成访问这个网站",
   "from": "domain"
  },
  "dest": {
   "label": "目标网站（Target）",
   "kind": "text",
   "group": "security",
   "flag": "--handshake-server",
   "placeholder": "留空与 SNI 相同",
   "note": "需支持 TLS 1.3 的真实网站",
   "from": "handshake_server"
  },
  "dest_port": {
   "label": "目标端口",
   "kind": "number",
   "group": "security",
   "flag": "--handshake-port",
   "value": 443,
   "from": "handshake_port"
  },
  "short_id": {
   "label": "Short ID",
   "kind": "text",
   "group": "security",
   "flag": "--short-id",
   "generate": "hex:8",
   "auto": true,
   "pattern": "^([0-9a-fA-F]{2}){1,8}$",
   "pattern_hint": "2-16 位十六进制，位数为偶数",
   "create_only": true
  },
  "reality_keys": {
   "label": "公钥 / 私钥",
   "kind": "text",
   "group": "security",
   "value": "创建时自动生成",
   "readonly": true,
   "create_only": true
  },
  "domain": {
   "label": "域名",
   "kind": "text",
   "group": "security",
   "flag": "--domain",
   "placeholder": "node.example.com",
   "required": true,
   "note": "需要域名证书；没有时自动签发（DNS 服务商在「设置」里填写）。",
   "from": "domain"
  },
  "listen": {
   "label": "监听",
   "kind": "text",
   "group": "basic",
   "flag": "--listen",
   "placeholder": "留空监听所有地址",
   "from": "listen",
   "edit": "no"
  },
  "proxy_listen": {
   "label": "监听",
   "kind": "select",
   "group": "basic",
   "flag": "--listen",
   "required": true,
   "options": [
    {
     "value": "127.0.0.1",
     "label": "127.0.0.1（仅本机）"
    },
    {
     "value": "0.0.0.0",
     "label": "0.0.0.0（所有 IPv4）"
    },
    {
     "value": "::",
     "label": "::（所有地址）"
    },
    {
     "value": "::1",
     "label": "::1"
    }
   ],
   "from": "listen",
   "edit": "no"
  },
  "security": {
   "label": "安全",
   "kind": "radio",
   "group": "security",
   "flag": "--security",
   "required": true,
   "options": [
    {
     "value": "reality",
     "label": "Reality"
    },
    {
     "value": "tls",
     "label": "TLS"
    }
   ],
   "from": "security",
   "edit": "no"
  },
  "flow": {
   "label": "Flow",
   "kind": "select",
   "group": "client",
   "flag": "--flow",
   "required": true,
   "emit_empty": true,
   "options": [
    {
     "value": "xtls-rprx-vision",
     "label": "xtls-rprx-vision"
    },
    {
     "value": "",
     "label": "无"
    }
   ],
   "when": {
    "transport": [
     ""
    ]
   },
   "hidden_emit": "",
   "from": "flow"
  },
  "transport": {
   "label": "传输",
   "kind": "radio",
   "group": "transport",
   "empty_label": "TCP (RAW)",
   "options": [
    {
     "value": "ws",
     "label": "WebSocket"
    },
    {
     "value": "grpc",
     "label": "gRPC"
    },
    {
     "value": "httpupgrade",
     "label": "HTTPUpgrade"
    },
    {
     "value": "http",
     "label": "HTTP/2"
    }
   ],
   "set": [
    [
     "inbound",
     "transport.type"
    ],
    [
     "outbound",
     "transport.type"
    ]
   ]
  },
  "t_path": {
   "label": "路径",
   "kind": "text",
   "group": "transport",
   "value": "/",
   "set": [
    [
     "inbound",
     "transport.path"
    ],
    [
     "outbound",
     "transport.path"
    ]
   ],
   "when": {
    "transport": [
     "ws",
     "httpupgrade",
     "http"
    ]
   }
  },
  "t_ws_host": {
   "label": "主机",
   "kind": "text",
   "group": "transport",
   "placeholder": "留空使用节点域名",
   "set": [
    [
     "outbound",
     "transport.headers.Host"
    ]
   ],
   "when": {
    "transport": [
     "ws"
    ]
   }
  },
  "t_host": {
   "label": "主机",
   "kind": "text",
   "group": "transport",
   "placeholder": "留空使用节点域名",
   "set": [
    [
     "inbound",
     "transport.host"
    ],
    [
     "outbound",
     "transport.host"
    ]
   ],
   "when": {
    "transport": [
     "httpupgrade"
    ]
   }
  },
  "t_http_host": {
   "label": "主机",
   "kind": "text",
   "group": "transport",
   "placeholder": "a.com,b.com",
   "type": "list",
   "set": [
    [
     "inbound",
     "transport.host"
    ],
    [
     "outbound",
     "transport.host"
    ]
   ],
   "when": {
    "transport": [
     "http"
    ]
   }
  },
  "t_service": {
   "label": "服务名称",
   "kind": "text",
   "group": "transport",
   "placeholder": "grpc",
   "set": [
    [
     "inbound",
     "transport.service_name"
    ],
    [
     "outbound",
     "transport.service_name"
    ]
   ],
   "when": {
    "transport": [
     "grpc"
    ]
   }
  },
  "t_early": {
   "label": "Early Data",
   "kind": "number",
   "group": "transport",
   "placeholder": "0 表示关闭",
   "type": "int",
   "set": [
    [
     "inbound",
     "transport.max_early_data"
    ],
    [
     "outbound",
     "transport.max_early_data"
    ],
    [
     "inbound",
     "transport.early_data_header_name",
     "Sec-WebSocket-Protocol"
    ],
    [
     "outbound",
     "transport.early_data_header_name",
     "Sec-WebSocket-Protocol"
    ]
   ],
   "when": {
    "transport": [
     "ws"
    ]
   }
  },
  "utls": {
   "label": "uTLS",
   "kind": "select",
   "group": "security",
   "options": [
    "chrome",
    "firefox",
    "safari",
    "ios",
    "android",
    "edge",
    "360",
    "qq",
    "random",
    "randomized"
   ],
   "empty_label": "chrome（默认）",
   "set": [
    [
     "outbound",
     "tls.utls.fingerprint"
    ],
    [
     "outbound",
     "tls.utls.enabled",
     true
    ]
   ]
  },
  "alpn": {
   "label": "ALPN",
   "kind": "tags",
   "group": "security",
   "options": [
    "h3",
    "h2",
    "http/1.1"
   ],
   "type": "list",
   "set": [
    [
     "inbound",
     "tls.alpn"
    ],
    [
     "outbound",
     "tls.alpn"
    ]
   ],
   "when": {
    "security": [
     "tls"
    ]
   }
  },
  "min_tls": {
   "label": "最低 TLS 版本",
   "kind": "select",
   "group": "security",
   "options": [
    "1.2",
    "1.3"
   ],
   "set": [
    [
     "inbound",
     "tls.min_version"
    ]
   ],
   "when": {
    "security": [
     "tls"
    ]
   }
  },
  "tfo": {
   "label": "TCP Fast Open",
   "kind": "switch",
   "group": "advanced",
   "set": [
    [
     "inbound",
     "tcp_fast_open",
     true
    ]
   ]
  },
  "mptcp": {
   "label": "MPTCP",
   "kind": "switch",
   "group": "advanced",
   "set": [
    [
     "inbound",
     "tcp_multi_path",
     true
    ]
   ]
  },
  "udp_fragment": {
   "label": "UDP 分片",
   "kind": "switch",
   "group": "advanced",
   "set": [
    [
     "inbound",
     "udp_fragment",
     true
    ]
   ]
  },
  "method": {
   "label": "加密方式",
   "kind": "select",
   "group": "proto",
   "flag": "--method",
   "required": true,
   "options": [
    "2022-blake3-aes-256-gcm",
    "2022-blake3-aes-128-gcm",
    "2022-blake3-chacha20-poly1305"
   ],
   "from": "method"
  },
  "mux": {
   "label": "多路复用",
   "kind": "switch",
   "group": "proto",
   "default": true,
   "invert": true,
   "flag": "--no-mux",
   "from": "multiplex",
   "edit": "no"
  },
  "up_mbps": {
   "label": "上行带宽",
   "kind": "number",
   "group": "proto",
   "suffix": "Mbps",
   "placeholder": "留空不限制",
   "type": "int",
   "set": [
    [
     "inbound",
     "up_mbps"
    ]
   ]
  },
  "down_mbps": {
   "label": "下行带宽",
   "kind": "number",
   "group": "proto",
   "suffix": "Mbps",
   "placeholder": "留空不限制",
   "type": "int",
   "set": [
    [
     "inbound",
     "down_mbps"
    ]
   ]
  },
  "ignore_bw": {
   "label": "忽略客户端带宽",
   "kind": "switch",
   "group": "proto",
   "set": [
    [
     "inbound",
     "ignore_client_bandwidth",
     true
    ]
   ]
  },
  "obfs": {
   "label": "混淆",
   "kind": "radio",
   "group": "proto",
   "flag": "--obfs",
   "empty_label": "无",
   "from": [
    "obfs.type",
    "obfs_mode"
   ],
   "from_map": {
    "none": ""
   },
   "edit_empty": "none"
  },
  "obfs_min": {
   "label": "最小包长",
   "kind": "number",
   "group": "proto",
   "flag": "--obfs-min-packet-size",
   "value": 512,
   "when": {
    "obfs": [
     "gecko"
    ]
   },
   "from": "obfs.min_packet_size"
  },
  "obfs_max": {
   "label": "最大包长",
   "kind": "number",
   "group": "proto",
   "flag": "--obfs-max-packet-size",
   "value": 1200,
   "when": {
    "obfs": [
     "gecko"
    ]
   },
   "from": "obfs.max_packet_size"
  },
  "obfs_host": {
   "label": "混淆主机",
   "kind": "text",
   "group": "proto",
   "flag": "--obfs-host",
   "value": "bing.com",
   "when": {
    "obfs": [
     "http"
    ]
   },
   "from": "obfs_host"
  },
  "masquerade": {
   "label": "伪装网址",
   "kind": "text",
   "group": "proto",
   "flag": "--masquerade",
   "placeholder": "https://example.com",
   "note": "非代理访问会看到这个网站",
   "from": "masquerade"
  },
  "bbr_profile": {
   "label": "BBR 档位",
   "kind": "select",
   "group": "proto",
   "flag": "--bbr-profile",
   "options": [
    "conservative",
    "standard",
    "aggressive"
   ],
   "from": "bbr_profile"
  },
  "congestion": {
   "label": "拥塞控制",
   "kind": "radio",
   "group": "proto",
   "flag": "--congestion-control",
   "required": true,
   "options": [
    "cubic",
    "new_reno",
    "bbr"
   ],
   "from": [
    "congestion_control",
    "quic_congestion_control"
   ]
  },
  "zero_rtt": {
   "label": "0-RTT 握手",
   "kind": "switch",
   "group": "proto",
   "set": [
    [
     "inbound",
     "zero_rtt_handshake",
     true
    ]
   ],
   "note": "有重放风险，一般不开"
  },
  "heartbeat": {
   "label": "心跳间隔",
   "kind": "text",
   "group": "proto",
   "placeholder": "10s",
   "set": [
    [
     "inbound",
     "heartbeat"
    ]
   ]
  },
  "naive_network": {
   "label": "网络",
   "kind": "radio",
   "group": "proto",
   "flag": "--network",
   "empty_label": "HTTP/2 (TCP)",
   "options": [
    {
     "value": "udp",
     "label": "QUIC (UDP)"
    }
   ],
   "from": "network",
   "from_map": {
    "tcp": ""
   },
   "edit_empty": "tcp"
  },
  "st_dest": {
   "label": "握手网站",
   "kind": "text",
   "group": "security",
   "flag": "--handshake-server",
   "placeholder": "留空使用推荐站点",
   "note": "借用它的 TLS 握手，需支持 TLS 1.3",
   "from": "handshake_server"
  },
  "st_dest_port": {
   "label": "握手端口",
   "kind": "number",
   "group": "security",
   "flag": "--handshake-port",
   "value": 443,
   "from": "handshake_port"
  },
  "strict_mode": {
   "label": "严格模式",
   "kind": "select",
   "group": "advanced",
   "flag": "--strict-mode",
   "options": [
    {
     "value": "true",
     "label": "开启"
    },
    {
     "value": "false",
     "label": "关闭"
    }
   ],
   "from": "strict_mode"
  },
  "wildcard_sni": {
   "label": "通配 SNI",
   "kind": "select",
   "group": "advanced",
   "flag": "--wildcard-sni",
   "options": [
    "off",
    "authed",
    "all"
   ],
   "from": "wildcard_sni"
  },
  "snell_version": {
   "label": "版本",
   "kind": "radio",
   "group": "proto",
   "flag": "--snell-version",
   "required": true,
   "options": [
    {
     "value": "5",
     "label": "v5"
    },
    {
     "value": "6",
     "label": "v6"
    }
   ],
   "from": "snell_version"
  },
  "snell_mode": {
   "label": "流量整形",
   "kind": "select",
   "group": "proto",
   "flag": "--snell-mode",
   "options": [
    "default",
    "unshaped",
    "unsafe-raw"
   ],
   "when": {
    "snell_version": [
     "6"
    ]
   },
   "from": "snell_mode"
  },
  "ws_path": {
   "label": "路径",
   "kind": "text",
   "group": "transport",
   "flag": "--path",
   "placeholder": "留空自动生成",
   "from": "ws_path"
  },
  "cf_domain": {
   "label": "域名",
   "kind": "text",
   "group": "security",
   "flag": "--domain",
   "placeholder": "经 Cloudflare 代理的域名",
   "from": "domain"
  },
  "t_idle": {
   "label": "空闲超时",
   "kind": "text",
   "group": "transport",
   "set": [
    [
     "inbound",
     "transport.idle_timeout"
    ],
    [
     "outbound",
     "transport.idle_timeout"
    ]
   ],
   "when": {
    "transport": [
     "grpc",
     "http"
    ]
   },
   "placeholder": "如 15s",
   "pattern": "^\\d+(ms|s|m|h)$",
   "pattern_hint": "时长，如 30s、5m"
  },
  "t_ping": {
   "label": "Ping 超时",
   "kind": "text",
   "group": "transport",
   "set": [
    [
     "inbound",
     "transport.ping_timeout"
    ],
    [
     "outbound",
     "transport.ping_timeout"
    ]
   ],
   "when": {
    "transport": [
     "grpc",
     "http"
    ]
   },
   "placeholder": "如 15s",
   "pattern": "^\\d+(ms|s|m|h)$",
   "pattern_hint": "时长，如 30s、5m"
  },
  "t_grpc_permit": {
   "label": "无流时也发送 Ping",
   "kind": "switch",
   "group": "transport",
   "set": [
    [
     "outbound",
     "transport.permit_without_stream",
     true
    ]
   ],
   "when": {
    "transport": [
