{
 "version": 2,
 "tool": "sb",
 "groups": [
  {
   "id": "basic",
   "label": "基础"
  },
  {
   "id": "reality",
   "label": "Reality"
  },
  {
   "id": "transport",
   "label": "传输"
  },
  {
   "id": "tls",
   "label": "TLS"
  },
  {
   "id": "tuning",
   "label": "性能与混淆"
  },
  {
   "id": "advanced",
   "label": "高级",
   "collapsed": true
  },
  {
   "id": "meta",
   "label": "备注与标签",
   "collapsed": true
  }
 ],
 "common": [
  "name",
  "address",
  "id",
  "disabled",
  "remark",
  "region",
  "purpose",
  "line",
  "tags"
 ],
 "fields": {
  "name": {
   "flag": "--name",
   "label": "名称",
   "kind": "text",
   "group": "basic",
   "placeholder": "留空使用协议默认名称"
  },
  "port": {
   "flag": "--port",
   "label": "端口",
   "kind": "number",
   "group": "basic"
  },
  "domain": {
   "flag": "--domain",
   "label": "域名",
   "kind": "text",
   "group": "basic",
   "placeholder": "node.example.com"
  },
  "address": {
   "flag": "--address",
   "label": "客户端连接地址",
   "kind": "text",
   "group": "advanced",
   "note": "留空自动使用域名或本机公网 IP"
  },
  "id": {
   "flag": "--id",
   "label": "节点 ID",
   "kind": "text",
   "group": "advanced",
   "note": "小写字母、数字、. _ -；留空自动生成"
  },
  "disabled": {
   "flag": "--disabled",
   "label": "创建后先不启用",
   "kind": "switch",
   "group": "advanced",
   "note": "不申请证书、不监听端口"
  },
  "remark": {
   "flag": "--remark",
   "label": "备注",
   "kind": "text",
   "group": "meta"
  },
  "region": {
   "flag": "--region",
   "label": "地区",
   "kind": "text",
   "group": "meta"
  },
  "purpose": {
   "flag": "--purpose",
   "label": "用途",
   "kind": "text",
   "group": "meta"
  },
  "line": {
   "flag": "--line",
   "label": "线路",
   "kind": "text",
   "group": "meta"
  },
  "tags": {
   "flag": "--tags",
   "label": "标签",
   "kind": "text",
   "group": "meta",
   "placeholder": "a,b"
  },
  "handshake_server": {
   "flag": "--handshake-server",
   "label": "握手目标（dest）",
   "kind": "text",
   "group": "reality",
   "placeholder": "留空与伪装域名相同",
   "note": "需支持 TLS 1.3 的真实网站"
  },
  "handshake_port": {
   "flag": "--handshake-port",
   "label": "握手端口",
   "kind": "number",
   "group": "reality",
   "default": 443
  },
  "masquerade": {
   "flag": "--masquerade",
   "label": "伪装网址",
   "kind": "text",
   "group": "tuning",
   "placeholder": "https://example.com",
   "note": "非代理请求会被反代到这个网站"
  },
  "security": {
   "flag": "--security",
   "label": "安全层",
   "kind": "select",
   "group": "basic",
   "required": true,
   "options": [
    {
     "value": "reality",
     "label": "Reality（无需证书）"
    },
    {
     "value": "tls",
     "label": "TLS（需要域名证书）"
    }
   ]
  },
  "sni": {
   "flag": "--domain",
   "label": "伪装域名（SNI）",
   "kind": "text",
   "group": "reality",
   "placeholder": "留空使用推荐站点"
  },
  "flow": {
   "flag": "--flow",
   "label": "流控（Flow）",
   "kind": "select",
   "group": "basic",
   "required": true,
   "emit_empty": true,
   "options": [
    {
     "value": "xtls-rprx-vision",
     "label": "xtls-rprx-vision"
    },
    {
     "value": "",
     "label": "无"
    }
   ],
   "when": {
    "transport": [
     ""
    ]
   },
   "hidden_emit": "",
   "note": "仅 TCP 可用；选择其他传输时自动关闭"
  },
  "transport": {
   "label": "传输方式",
   "kind": "select",
   "group": "transport",
   "options": [
    {
     "value": "ws",
     "label": "WebSocket"
    },
    {
     "value": "grpc",
     "label": "gRPC"
    },
    {
     "value": "httpupgrade",
     "label": "HTTPUpgrade"
    },
    {
     "value": "http",
     "label": "HTTP/2"
    }
   ],
   "empty_label": "TCP",
   "set": [
    [
     "inbound",
     "transport.type"
    ],
    [
     "outbound",
     "transport.type"
    ]
   ]
  },
  "t_path": {
   "label": "路径",
   "kind": "text",
   "group": "transport",
   "placeholder": "/path",
   "set": [
    [
     "inbound",
     "transport.path"
    ],
    [
     "outbound",
     "transport.path"
    ]
   ],
   "when": {
    "transport": [
     "ws",
     "httpupgrade",
     "http"
    ]
   }
  },
  "t_ws_host": {
   "label": "Host",
   "kind": "text",
   "group": "transport",
   "placeholder": "留空使用节点域名",
   "set": [
    [
     "outbound",
     "transport.headers.Host"
    ]
   ],
   "when": {
    "transport": [
     "ws"
    ]
   }
  },
  "t_host": {
   "label": "Host",
   "kind": "text",
   "group": "transport",
   "placeholder": "留空使用节点域名",
   "set": [
    [
     "inbound",
     "transport.host"
    ],
    [
     "outbound",
     "transport.host"
    ]
   ],
   "when": {
    "transport": [
     "httpupgrade"
    ]
   }
  },
  "t_http_host": {
   "label": "Host",
   "kind": "text",
   "group": "transport",
   "placeholder": "a.com,b.com",
   "type": "list",
   "set": [
    [
     "inbound",
     "transport.host"
    ],
    [
     "outbound",
     "transport.host"
    ]
   ],
   "when": {
    "transport": [
     "http"
    ]
   }
  },
  "t_service": {
   "label": "服务名（serviceName）",
   "kind": "text",
   "group": "transport",
   "placeholder": "grpc",
   "set": [
    [
     "inbound",
     "transport.service_name"
    ],
    [
     "outbound",
     "transport.service_name"
    ]
   ],
   "when": {
    "transport": [
     "grpc"
    ]
   }
  },
  "t_early": {
   "label": "Early Data 长度",
   "kind": "number",
   "group": "transport",
   "placeholder": "0 表示关闭",
   "type": "int",
   "set": [
    [
     "inbound",
     "transport.max_early_data"
    ],
    [
     "outbound",
     "transport.max_early_data"
    ],
    [
     "inbound",
     "transport.early_data_header_name",
     "Sec-WebSocket-Protocol"
    ],
    [
     "outbound",
     "transport.early_data_header_name",
     "Sec-WebSocket-Protocol"
    ]
   ],
   "when": {
    "transport": [
     "ws"
    ]
   }
  },
  "alpn": {
   "label": "ALPN",
   "kind": "text",
   "group": "tls",
   "placeholder": "h2,http/1.1",
   "type": "list",
   "set": [
    [
     "inbound",
     "tls.alpn"
    ],
    [
     "outbound",
     "tls.alpn"
    ]
   ],
   "when": {
    "security": [
     "tls"
    ]
   }
  },
  "min_tls": {
   "label": "最低 TLS 版本",
   "kind": "select",
   "group": "tls",
   "options": [
    "1.2",
    "1.3"
   ],
   "set": [
    [
     "inbound",
     "tls.min_version"
    ]
   ],
   "when": {
    "security": [
     "tls"
    ]
   }
  },
  "fingerprint": {
   "label": "客户端指纹（uTLS）",
   "kind": "select",
   "group": "tls",
   "options": [
    "chrome",
    "firefox",
    "safari",
    "ios",
    "android",
    "edge",
    "360",
    "qq",
    "random",
    "randomized"
   ],
   "set": [
    [
     "outbound",
     "tls.utls.fingerprint"
    ],
    [
     "outbound",
     "tls.utls.enabled",
     true
    ]
   ],
   "note": "写入分享链接与客户端配置"
  },
  "listen": {
   "flag": "--listen",
   "label": "监听地址",
   "kind": "text",
   "group": "advanced",
   "placeholder": "默认 ::"
  },
  "tfo": {
   "label": "TCP Fast Open",
   "kind": "switch",
   "group": "advanced",
   "set": [
    [
     "inbound",
     "tcp_fast_open",
     true
    ]
   ]
  },
  "mptcp": {
   "label": "MPTCP",
   "kind": "switch",
   "group": "advanced",
   "set": [
    [
     "inbound",
     "tcp_multi_path",
     true
    ]
   ]
  },
  "udp_fragment": {
   "label": "允许 UDP 分片",
   "kind": "switch",
   "group": "advanced",
   "set": [
    [
     "inbound",
     "udp_fragment",
     true
    ]
   ]
  },
  "method": {
   "flag": "--method",
   "label": "加密方法",
   "kind": "select",
   "group": "basic",
   "required": true,
   "options": [
    "2022-blake3-aes-256-gcm",
    "2022-blake3-aes-128-gcm",
    "2022-blake3-chacha20-poly1305"
   ]
  },
  "no_mux": {
   "flag": "--no-mux",
   "label": "关闭多路复用",
   "kind": "switch",
   "group": "advanced"
  },
  "obfs": {
   "flag": "--obfs",
   "label": "混淆",
   "kind": "select",
   "group": "tuning"
  },
  "obfs_host": {
   "flag": "--obfs-host",
   "label": "混淆 Host",
   "kind": "text",
   "group": "tuning",
   "placeholder": "bing.com",
   "when": {
    "obfs": [
     "http"
    ]
   }
  },
  "obfs_min": {
   "flag": "--obfs-min-packet-size",
   "label": "Gecko 最小包长",
   "kind": "number",
   "group": "tuning",
   "default": 512,
   "when": {
    "obfs": [
     "gecko"
    ]
   }
  },
  "obfs_max": {
   "flag": "--obfs-max-packet-size",
   "label": "Gecko 最大包长",
   "kind": "number",
   "group": "tuning",
   "default": 1200,
   "when": {
    "obfs": [
     "gecko"
    ]
   }
  },
  "up_mbps": {
   "label": "上行带宽（Mbps）",
   "kind": "number",
   "group": "tuning",
   "type": "int",
   "set": [
    [
     "inbound",
     "up_mbps"
    ]
   ],
   "note": "服务器上行；留空不限制"
  },
  "down_mbps": {
   "label": "下行带宽（Mbps）",
   "kind": "number",
   "group": "tuning",
   "type": "int",
   "set": [
    [
     "inbound",
     "down_mbps"
    ]
   ]
  },
  "ignore_bw": {
   "label": "忽略客户端声明的带宽",
   "kind": "switch",
   "group": "tuning",
   "set": [
    [
     "inbound",
     "ignore_client_bandwidth",
     true
    ]
   ]
  },
  "bbr_profile": {
   "flag": "--bbr-profile",
   "label": "BBR 档位",
   "kind": "select",
   "group": "tuning",
   "options": [
    "conservative",
    "standard",
    "aggressive"
   ],
   "note": "需要 sing-box 1.14+"
  },
  "disable_chrome_parrot": {
   "flag": "--disable-chrome-parrot",
   "label": "关闭 Chrome QUIC 指纹",
   "kind": "switch",
   "group": "advanced"
  },
  "brutal_debug": {
   "flag": "--brutal-debug",
   "label": "Brutal 调试日志",
   "kind": "switch",
   "group": "advanced"
  },
  "realm_id": {
   "flag": "--realm-id",
   "label": "Realm ID",
   "kind": "text",
   "group": "advanced",
   "note": "需先启用全局 Hysteria Realm"
  },
  "realm_ip_version": {
   "flag": "--realm-ip-version",
   "label": "Realm IP 版本",
   "kind": "select",
   "group": "advanced",
   "options": [
    "0",
    "4",
    "6"
   ],
   "when_filled": "realm_id"
  },
  "realm_port_mapping": {
   "flag": "--realm-port-mapping",
   "label": "Realm 端口映射",
   "kind": "switch",
   "group": "advanced",
   "when_filled": "realm_id"
  },
  "congestion_control": {
   "flag": "--congestion-control",
   "label": "拥塞控制",
   "kind": "select",
   "group": "tuning",
   "options": [
    "cubic",
    "new_reno",
    "bbr"
   ]
  },
  "zero_rtt": {
   "label": "0-RTT 握手",
   "kind": "switch",
   "group": "tuning",
   "set": [
    [
     "inbound",
     "zero_rtt_handshake",
     true
    ]
   ],
   "note": "有重放风险，官方不建议开启"
  },
  "heartbeat": {
   "label": "心跳间隔",
   "kind": "text",
   "group": "tuning",
   "placeholder": "10s",
   "set": [
    [
     "inbound",
     "heartbeat"
    ]
   ]
  },
  "auth_timeout": {
   "label": "认证超时",
   "kind": "text",
   "group": "tuning",
   "placeholder": "3s",
   "set": [
    [
     "inbound",
     "auth_timeout"
    ]
   ]
  },
  "naive_network": {
   "flag": "--network",
   "label": "网络",
   "kind": "select",
   "group": "basic",
   "options": [
    {
     "value": "udp",
     "label": "QUIC（UDP）"
    }
   ],
   "empty_label": "HTTP/2（TCP）"
  },
  "st_handshake": {
   "flag": "--handshake-server",
   "label": "握手目标",
   "kind": "text",
   "group": "basic",
   "placeholder": "留空使用推荐站点",
   "note": "借用它的 TLS 握手，需支持 TLS 1.3"
  },
  "st_handshake_port": {
   "flag": "--handshake-port",
   "label": "握手端口",
   "kind": "number",
   "group": "basic",
   "default": 443
  },
  "strict_mode": {
   "flag": "--strict-mode",
   "label": "严格模式",
   "kind": "select",
   "group": "advanced",
   "options": [
    "true",
    "false"
   ]
  },
  "wildcard_sni": {
   "flag": "--wildcard-sni",
   "label": "通配 SNI",
   "kind": "select",
   "group": "advanced",
   "options": [
    "off",
    "authed",
    "all"
   ]
  },
  "snell_version": {
   "flag": "--snell-version",
   "label": "Snell 版本",
   "kind": "select",
   "group": "basic",
   "required": true,
   "options": [
    "5",
    "6"
   ]
  },
  "snell_mode": {
   "flag": "--snell-mode",
   "label": "流量整形模式",
   "kind": "select",
   "group": "tuning",
   "options": [
    "default",
    "unshaped",
    "unsafe-raw"
   ],
   "when": {
    "snell_version": [
     "6"
    ]
   }
  },
  "path": {
   "flag": "--path",
   "label": "WebSocket 路径",
   "kind": "text",
   "group": "basic",
   "placeholder": "留空自动生成"
  },
  "proxy_listen": {
   "flag": "--listen",
   "label": "监听地址",
   "kind": "select",
   "group": "basic",
   "options": [
    "127.0.0.1",
    "::1",
    "0.0.0.0",
    "::"
   ],
   "empty_label": "127.0.0.1（仅本机）"
  }
 },
 "json_flags": {
  "inbound": "--sing-box-inbound-json",
  "outbound": "--sing-box-outbound-json"
 },
 "protocols": [
  {
   "type": "vless",
   "label": "VLESS",
   "note": "推荐 Reality + Vision：不需要域名和证书。",
   "fields": [
    "security",
    {
     "key": "domain",
     "required": true,
     "when": {
      "security": [
       "tls"
      ]
     }
    },
    {
     "key": "sni",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "handshake_server",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "handshake_port",
     "when": {
      "security": [
       "reality"
      ]
     }
    },
    {
     "key": "port",
     "default": 443
    },
    "flow",
    "transport",
    "t_path",
    "t_ws_host",
    "t_host",
    "t_http_host",
    "t_service",
    "t_early",
    "alpn",
    "min_tls",
    "fingerprint",
    "listen",
    "tfo",
    "mptcp"
   ]
  },
  {
   "type": "hy2",
   "label": "Hysteria2",
   "note": "需要域名证书：没有可用证书时会通过 Cloudflare DNS 自动签发（先在终端执行一次 cert setup-cloudflare）。",
   "fields": [
    {
     "key": "domain",
     "required": true
    },
    {
     "key": "port",
     "default": 443
    },
    "up_mbps",
    "down_mbps",
    "ignore_bw",
    {
     "key": "obfs",
     "options": [
      "salamander",
      "gecko"
     ],
     "note": "gecko 需要 sing-box 1.14+"
    },
    "obfs_min",
    "obfs_max",
    "masquerade",
    "bbr_profile",
    "udp_fragment",
    "disable_chrome_parrot",
    "brutal_debug",
    "realm_id",
    "realm_ip_version",
    "realm_port_mapping"
   ]
  },
  {
   "type": "tuic",
   "label": "TUIC",
   "note": "需要域名证书：没有可用证书时会通过 Cloudflare DNS 自动签发（先在终端执行一次 cert setup-cloudflare）。",
   "fields": [
    {
     "key": "domain",
     "required": true
    },
    {
     "key": "port",
     "default": 443
    },
    "congestion_control",
    "zero_rtt",
    "heartbeat",
    "auth_timeout",
    "udp_fragment"
   ]
  },
  {
   "type": "trojan",
   "label": "Trojan",
   "note": "需要域名证书：没有可用证书时会通过 Cloudflare DNS 自动签发（先在终端执行一次 cert setup-cloudflare）。",
   "fields": [
    {
     "key": "domain",
     "required": true
    },
    {
     "key": "port",
     "default": 443
    },
    "tfo",
    "mptcp"
   ]
  },
  {
   "type": "anytls",
   "label": "AnyTLS",
   "note": "需要域名证书：没有可用证书时会通过 Cloudflare DNS 自动签发（先在终端执行一次 cert setup-cloudflare）。",
   "fields": [
    {
     "key": "domain",
     "required": true
    },
    {
     "key": "port",
     "default": 443
    },
    "tfo",
    "mptcp"
   ]
  },
  {
   "type": "naive",
   "label": "NaiveProxy",
   "note": "需要域名证书：没有可用证书时会通过 Cloudflare DNS 自动签发（先在终端执行一次 cert setup-cloudflare）。",
   "fields": [
    {
     "key": "domain",
     "required": true
    },
    {
     "key": "port",
     "default": 443
    },
    "naive_network"
   ]
  },
  {
   "type": "ss",
   "label": "Shadowsocks 2022",
   "note": "密钥自动生成。",
   "fields": [
    {
     "key": "port",
     "default": 8388
    },
    "method",
    "no_mux",
    "tfo",
    "mptcp"
   ]
  },
  {
   "type": "shadowtls",
   "label": "ShadowTLS v3",
   "note": "ShadowTLS v3 + Shadowsocks 2022，借用握手目标站点的 TLS，不需要证书。",
   "fields": [
    {
     "key": "port",
     "default": 443
    },
    "st_handshake",
    "st_handshake_port",
    "strict_mode",
    "wildcard_sni"
   ]
  },
  {
   "type": "snell",
   "label": "Snell",
   "note": "需要 sing-box 1.14+；v6 需要 1.14 rc.2+。",
   "fields": [
    {
     "key": "port",
     "default": 6160
    },
    "snell_version",
    {
     "key": "obfs",
     "options": [
      "http"
     ],
     "when": {
      "snell_version": [
       "5"
      ]
     }
    },
    "obfs_host",
    "snell_mode"
   ]
  },
