   }
  },
  "t_http_method": {
   "label": "请求方法",
   "kind": "select",
   "group": "transport",
   "set": [
    [
     "inbound",
     "transport.method"
    ],
    [
     "outbound",
     "transport.method"
    ]
   ],
   "when": {
    "transport": [
     "http"
    ]
   },
   "options": [
    "PUT",
    "GET",
    "POST"
   ],
   "empty_label": "默认（PUT）"
  },
  "mux_allow": {
   "label": "多路复用",
   "kind": "switch",
   "group": "proto",
   "set": [
    [
     "inbound",
     "multiplex.enabled",
     true
    ]
   ],
   "note": "允许客户端使用多路复用；不使用的客户端照常连接。"
  },
  "mux_padding": {
   "label": "复用填充",
   "kind": "switch",
   "group": "proto",
   "set": [
    [
     "inbound",
     "multiplex.padding",
     true
    ]
   ],
   "when": {
    "mux_allow": [
     "1"
    ]
   },
   "note": "开启后只接受启用了填充的多路复用连接。"
  },
  "mux_brutal": {
   "label": "TCP Brutal",
   "kind": "switch",
   "group": "proto",
   "set": [
    [
     "inbound",
     "multiplex.brutal.enabled",
     true
    ]
   ],
   "when": {
    "mux_allow": [
     "1"
    ]
   },
   "note": "需要服务器内核已加载 tcp-brutal 模块。"
  },
  "mux_brutal_up": {
   "label": "Brutal 上行",
   "kind": "number",
   "group": "proto",
   "type": "int",
   "suffix": "Mbps",
   "set": [
    [
     "inbound",
     "multiplex.brutal.up_mbps"
    ]
   ],
   "when": {
    "mux_allow": [
     "1"
    ],
    "mux_brutal": [
     "1"
    ]
   }
  },
  "mux_brutal_down": {
   "label": "Brutal 下行",
   "kind": "number",
   "group": "proto",
   "type": "int",
   "suffix": "Mbps",
   "set": [
    [
     "inbound",
     "multiplex.brutal.down_mbps"
    ]
   ],
   "when": {
    "mux_allow": [
     "1"
    ],
    "mux_brutal": [
     "1"
    ]
   }
  },
  "tls_max": {
   "label": "最高 TLS 版本",
   "kind": "select",
   "group": "security",
   "set": [
    [
     "inbound",
     "tls.max_version"
    ]
   ],
   "options": [
    "1.2",
    "1.3"
   ],
   "empty_label": "默认（1.3）"
  },
  "tls_ciphers": {
   "label": "加密套件",
   "kind": "tags",
   "group": "security",
   "type": "list",
   "set": [
